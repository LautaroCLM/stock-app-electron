# Configuración de Entorno para Supabase (Plantilla)
# Copia este archivo a '.env' en la raíz de tu proyecto y completa tus credenciales.
# El archivo '.env' está ignorado en git por seguridad.

APP_MODE=LOCAL
ENABLE_SYNC=false
ENABLE_QUEUE=false

# Credenciales de Supabase
SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui